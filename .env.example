# EasyJobs — environment for the whole monorepo.
#   cp .env.example .env && pnpm dev
# Every app and package loads the repo-root .env (Next.js via @next/env); variables already set in your shell win.
# The CORE block is active. Everything below it is commented out at its default — uncomment to change.
# Per-package details: each package's README / .env.example (merged below by section).

# ══ Core ══════════════════════════════════════════════════════════════════════════════════════════

# Ports (prompts.md §0.7): web 3000 · api 4000 · worker 4100 · docker postgres 5433.
# If you change WEB_PORT / API_PORT, change the URLs below to match.
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4100

# The worker POSTs jobs to API_URL; the web reads NEXT_PUBLIC_API_URL (browser + server).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# CORS allow-list of the API (comma-separated)
WEB_ORIGIN=http://localhost:3000

# Worker → API ingest auth (x-ingest-key). Change it anywhere but your laptop.
INGEST_API_KEY=dev-ingest-key

# 0 = real API (default since W1) · 1 = in-memory mock data (offline UI work, e2e)
NEXT_PUBLIC_USE_MOCKS=0

# Unset → embedded Postgres (PGlite) at .data/pglite — no Docker needed.
# Postgres via `docker compose up -d db`: postgres://easyjobs:easyjobs@localhost:5433/easyjobs
# DATABASE_URL=

# Identify the crawler — put a real contact URL here before crawling from a server.
SCRAPER_USER_AGENT="EasyJobsBot/1.0 (+https://easyjobs.example/bot)"
LOG_LEVEL=info
# LOG_FORMAT=json

# ── Sources ──
# Scraper ids the worker must never run (comma-separated), e.g. `workday,themuse` when your IP gets challenged.
WORKER_DISABLED_SOURCES=
# LinkedIn and Naukri restrict automated access: off by default — enable at your own discretion.
ENABLE_LINKEDIN=0
ENABLE_NAUKRI=0

# ── Optional free keys: more data, sharper logos, LLM extraction ──
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=
# LOGO_DEV_TOKEN=
# ANTHROPIC_API_KEY=

# ── Root scripts ──
# pnpm scrape:once → every enabled scraper once; ATS scrapers take at most SCRAPE_MAX_TARGETS boards each.
# SCRAPE_LIMIT=30
# SCRAPE_MAX_TARGETS=2

# ══ API (apps/api) · HTTP server ══════════════════════════════════════════════════════════════════
# (from apps/api/.env.example)
# @easyjobs/api — Hono on Node (the root .env is loaded automatically). DB variables: packages/db/.env.example

# API_PORT  ← see above
# API_HOST=0.0.0.0            # listen address (default: all interfaces)
# WEB_ORIGIN  ← see above
# INGEST_API_KEY  ← see above

# Per-IP token bucket on public /v1/* routes (0 disables). TRUST_PROXY=1 → use X-Forwarded-For.
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=100
# TRUST_PROXY=0

# In-memory LRU for search / facets / stats / suggest (0 disables) — responses also carry ETag + Cache-Control.
# CACHE_TTL_MS=20000
# CACHE_MAX_ENTRIES=2000

# Live stream (/v1/stream)
# SSE_HEARTBEAT_MS=25000
# SSE_STATS_MS=30000
# SSE_MAX_PER_IP=20
# SSE_MAX_CLIENTS=5000

# Freshness rules (validThrough, 21/45-day board-only rules) run this often.
# EXPIRE_INTERVAL_MS=3600000

# Body limits for /v1/ingest/* (bytes; gzip/deflate/br request bodies are decompressed up to the inflated limit)
# INGEST_MAX_BYTES=16777216
# INGEST_MAX_INFLATED_BYTES=67108864
# INGEST_OTHER_MAX_BYTES=16777216

# LOG_LEVEL  ← see above
# LOG_FORMAT  ← see above

# ══ Database (packages/db) ════════════════════════════════════════════════════════════════════════
# (from packages/db/.env.example)
# @easyjobs/db — database driver (shared with apps/api; the root .env is loaded automatically)

# Postgres connection string. Leave empty to use embedded PGlite (zero installs).
#   docker compose up -d db  →  postgres://easyjobs:easyjobs@localhost:5433/easyjobs
# DATABASE_URL  ← see above

# PGlite data directory when DATABASE_URL is empty (relative to the repo root). "memory://" = in-memory.
# PGLITE_DIR=.data/pglite

# postgres.js pool size and per-statement timeout.
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=30000
# Postgres max_parallel_workers_per_gather for API sessions (0 = searches parallelise across statements instead).
# DB_PARALLEL_WORKERS=0

# Run the test suite against a real server too (each test file gets a throw-away database).
# TEST_DATABASE_URL=postgres://localhost:5432/postgres

# ══ Worker (apps/worker) · scheduler + ingestion ══════════════════════════════════════════════════
# (from apps/worker/.env.example)
# @easyjobs/worker — every variable is optional; defaults shown.

# Ingest API (apps/api) and the shared key for /v1/ingest/* (also guards POST /run/:source on the worker).
# API_URL  ← see above
# INGEST_API_KEY  ← see above

# Status server: GET /health, GET /status, POST /run/:source. Use 0.0.0.0 inside containers.
# WORKER_PORT  ← see above
# WORKER_HOST=127.0.0.1

# Concurrency: global running tasks, and per scraper (1–2). Per-task timeout in minutes.
# WORKER_CONCURRENCY=6
# WORKER_PER_SCRAPER_CONCURRENCY=2
# WORKER_TASK_TIMEOUT_MINUTES=30

# Cadence: ATS targets by registry priority 1,2,3 (minutes); floor for scraper.intervalMinutes.
# WORKER_PRIORITY_MINUTES=15,60,1440
# WORKER_MIN_INTERVAL_MINUTES=5
# First (or overdue-after-restart) runs are spread over min(interval, this) with ± WORKER_JITTER.
# WORKER_INITIAL_SPREAD_MINUTES=60
# WORKER_JITTER=0.1

# Incremental runs pass ctx.since; a full listing (needed for sweeps) happens at least this often. 0 = always full.
# WORKER_FULL_REFRESH_MINUTES=60
# WORKER_SINCE_OVERLAP_MINUTES=10

# Failures: backoff 2, 4, 8, 16 … min; circuit opens after N consecutive failures and pauses the task.
# WORKER_BACKOFF_BASE_MINUTES=2
# WORKER_BREAKER_THRESHOLD=5
# WORKER_BREAKER_PAUSE_HOURS=6

# Ingest requests.
# WORKER_BATCH_SIZE=200
# WORKER_GZIP=1
# WORKER_API_TIMEOUT_MS=30000
# WORKER_API_RETRIES=3

# Discovery.
# WORKER_RESCAN_MINUTES=10
# WORKER_IMPORT_TIMEOUT_MS=30000
# demo scraper: auto = only when no scraper packages exist · 1 = always · 0 = never
# WORKER_DEMO=auto
# WORKER_DEMO_JOBS=30

# Safety caps.
# WORKER_MAX_JOBS_PER_RUN=20000
# WORKER_SPOOL_MAX_MB=1024
# WORKER_SHUTDOWN_GRACE_MS=15000

# Paths (defaults: apps/worker/.state, .spool, out; repo root auto-detected).
# WORKER_REPO_ROOT=
# WORKER_STATE_DIR=
# WORKER_SPOOL_DIR=
# WORKER_OUT_DIR=

# Logging (shared): LOG_LEVEL=debug, LOG_FORMAT=json
# LOG_LEVEL  ← see above
# LOG_FORMAT  ← see above

# ══ Web (apps/web) ════════════════════════════════════════════════════════════════════════════════
# (from apps/web/.env.example)
# EasyJobs web (apps/web). Copy the keys you need into the repo-root .env.
# "1" (default) = in-memory mock API; "0" = real API at NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_USE_MOCKS  ← see above
# NEXT_PUBLIC_API_URL  ← see above
# Optional: server-side base URL for the API when it differs from the public one (Docker, private network).
# API_INTERNAL_URL=
# NEXT_PUBLIC_SITE_URL  ← see above
# Optional: simulated network latency for the browser mock (ms).
# NEXT_PUBLIC_MOCK_LATENCY_MS=120
# Optional (server-only): logo.dev token for sharper company logos via the /logo/<domain> proxy.
# LOGO_DEV_TOKEN  ← see above

# ══ Normalizer (packages/normalize) ═══════════════════════════════════════════════════════════════
# (from packages/normalize/.env.example)
# @easyjobs/normalize: every variable is optional. Without any of them, the normalizer is fully offline.
# The library reads process.env when it is called; host apps load it themselves (the worker loads <repo>/.env).
# The CLI loads packages/normalize/.env, then <repo>/.env, if present. Variables already set in the shell win.

# companyLogoUrl: with a token, https://img.logo.dev/<domain>?token=…&size=128; without one, the Google favicon.
# LOGO_DEV_TOKEN  ← see above

# Optional enrichWithLLM, for low-confidence records only. Without a key it does nothing.
# ANTHROPIC_API_KEY  ← see above
# Model override (default claude-haiku-5-5).
# NORMALIZE_LLM_MODEL=claude-haiku-5-5
# Disk cache keyed by fingerprint (default packages/normalize/.cache/llm, gitignored).
# NORMALIZE_LLM_CACHE_DIR=
# CLI --llm: max API requests per run (default 100). Cache hits don't count.
# NORMALIZE_LLM_MAX_CALLS=100

# Tests only: throughput floor that test/perf.test.ts asserts, in jobs per main-thread CPU-second.
# The default is a 500 jobs/s sanity floor; 5000 enforces the target (run it on a machine that isn't swapping).
# PERF_MIN_JOBS_PER_SEC=

# ══ Registry (packages/registry) ══════════════════════════════════════════════════════════════════
# (from packages/registry/.env.example)
# @easyjobs/registry — only the maintenance scripts (detect / probe / verify) make requests; the library does no I/O.
# Identify the bot on every request (prompts.md §0.7). Use a real contact URL in production.
# SCRAPER_USER_AGENT  ← see above
# info | debug
# LOG_LEVEL  ← see above
# pretty (default) | json
# LOG_FORMAT  ← see above

# ══ Scrapers · CourseJoiner & job blogs (packages/scrapers/coursejoiner) ══════════════════════════
# (from packages/scrapers/coursejoiner/.env.example)
# @easyjobs/scraper-coursejoiner — CourseJoiner + FreshersHunt + FresherOffCampus + KickCharm
# Bot identity (robots.txt groups are matched against it). Defaults to the contract's DEFAULT_USER_AGENT.
# SCRAPER_USER_AGENT  ← see above

# Per-site toggles (default on; set 0 to disable)
# ENABLE_COURSEJOINER=1
# ENABLE_FRESHERSHUNT=1
# ENABLE_FRESHEROFFCAMPUS=1
# ENABLE_KICKCHARM=1

# Backfill / refresh window in days (default 60). Per site: COURSEJOINER_BACKFILL_DAYS, FRESHERSHUNT_BACKFILL_DAYS, …
# WPJOBS_BACKFILL_DAYS=60
# When the worker passes ctx.since, run a full-window refresh at most every N hours (default 24)
# WPJOBS_REFRESH_HOURS=24
# Cache root (default: packages/scrapers/coursejoiner/.cache). "off" = in-memory only.
# WPJOBS_CACHE_DIR=

# Optional LLM extraction for low-confidence posts (not needed; heuristics work without it)
# ANTHROPIC_API_KEY  ← see above
# WPJOBS_LLM=1
# WPJOBS_LLM_MODEL=claude-haiku-5-5
# WPJOBS_LLM_MAX_CALLS=30

# ══ Scrapers · public ATS APIs (packages/scrapers/ats-public) ═════════════════════════════════════
# (from packages/scrapers/ats-public/.env.example)
# @easyjobs/scraper-ats-public — all optional

# Comma-separated scraper ids to switch off (greenhouse, lever, ashby, smartrecruiters, workable,
# recruitee, bamboohr, personio, breezy, teamtailor), or "all".
# ATS_PUBLIC_DISABLED=

# Max per-posting detail requests per target per run (SmartRecruiters, BambooHR). Unknown postings beyond the
# cap are fetched on the next run.
# ATS_MAX_DETAILS=200

# Bot identity used by the contract HTTP client (put a real contact URL here in production).
# SCRAPER_USER_AGENT  ← see above

# Set to 1 to run test/live.test.ts against the real APIs.
# LIVE=

# ══ Scrapers · enterprise ATS (packages/scrapers/ats-enterprise) ══════════════════════════════════
# (from packages/scrapers/ats-enterprise/.env.example)
# @easyjobs/scraper-ats-enterprise — all optional. See README.md for details.

# Workday (one politeness gate shared by ALL tenants: Cloudflare challenges per client IP)
# WORKDAY_MAX_DETAILS=300        # detail calls per target per run (unknown jobs only)
# WORKDAY_OVERFLOW=defer         # defer | light — what to do with unknown jobs over the budget
# WORKDAY_DELAY_MS=3000          # gap between Workday requests (floor 400)
# WORKDAY_CONCURRENCY=1          # 1–2
# WORKDAY_TIMEOUT_MS=25000

# Oracle Recruiting Cloud (per REST host)
# ORACLE_MAX_DETAILS=300
# ORACLE_OVERFLOW=defer
# ORACLE_DELAY_MS=600
# ORACLE_TIMEOUT_MS=30000

# Eightfold (one gate for all tenants; slow, 429-prone API)
# EIGHTFOLD_MAX_DETAILS=100
# EIGHTFOLD_OVERFLOW=defer
# EIGHTFOLD_DELAY_MS=2500
# EIGHTFOLD_TIMEOUT_MS=60000

# JSON-LD career sites (HTML; robots.txt respected; ≤ 1 request/second per host)
# JSONLD_MAX_PAGES=200
# JSONLD_MAX_SITEMAPS=40
# JSONLD_MAX_LISTING_PAGES=10
# JSONLD_DELAY_MS=1000

# Page-based platforms (same politeness as JSON-LD)
# SUCCESSFACTORS_MAX_DETAILS=200
# PHENOM_MAX_DETAILS=200
# AVATURE_MAX_DETAILS=200
# ICIMS_MAX_DETAILS=200
# TALEO_MAX_DETAILS=150

# Run control
# ATS_ENTERPRISE_TARGET_BUDGET_MIN=25   # wall-clock budget per target; exceeding it ends the run as incomplete
# ATS_ENTERPRISE_STATE_DIR=           # page index for sitemap-driven sources (default: package .cache/state; "off" disables)

# Development only: cache successful responses on disk to avoid re-hitting sites
# ATS_ENTERPRISE_CACHE=1
# ATS_ENTERPRISE_CACHE_TTL_MIN=360

# ══ Scrapers · custom career portals (packages/scrapers/bigtech) ══════════════════════════════════
# (from packages/scrapers/bigtech/.env.example)
# @easyjobs/scraper-bigtech — every variable is optional.

# Identify the bot (shared with all scrapers; default below).
# SCRAPER_USER_AGENT  ← see above

# Comma-separated scraper ids to switch off, e.g. "amazon,ibm".
# BIGTECH_DISABLE=

# Max detail fetches per scraper run (default 200). Unknown jobs beyond the cap are deferred to the next run.
# BIGTECH_MAX_DETAILS=200

# Minimum gap between requests to the same host, in ms (default 1000 → ≤ 1 request/second). It can only raise a
# site's own floor (Microsoft uses 10 s); 0 disables throttling (offline tests only).
# BIGTECH_MIN_GAP_MS=1000

# Max list pages per run (default per site, usually 100).
# BIGTECH_MAX_PAGES=

# Development only: cache HTTP responses on disk in packages/scrapers/bigtech/.cache/http.
# BIGTECH_DEV_CACHE=0
# BIGTECH_DEV_CACHE_TTL_MIN=360

# ══ Scrapers · Internshala (packages/scrapers/internshala) ════════════════════════════════════════
# (from packages/scrapers/internshala/.env.example)
# @easyjobs/scraper-internshala — every variable is optional (defaults shown).

# 0/false disables both Internshala scrapers.
# INTERNSHALA_ENABLED=1
# Listing pages per feed per run ("all" for a one-off backfill).
# INTERNSHALA_MAX_PAGES=10
# Detail pages per scraper run ("all" = no cap, 0 = cards only).
# INTERNSHALA_MAX_DETAILS=100
# Rotating deeper pages of the main feed per incremental run (keeps long-lived postings "seen").
# INTERNSHALA_REFRESH_PAGES=2
# Consecutive pages made entirely of known ids that end a feed.
# INTERNSHALA_STOP_AFTER_KNOWN_PAGES=1
# Gap between requests in ms (minimum 1500 — Internshala's budget is ≤ 1 request / 1.5 s).
# INTERNSHALA_DELAY_MS=1500
# Feeds to crawl, in order.
# INTERNSHALA_INTERNSHIP_FEEDS=main,wfh,women
# INTERNSHALA_JOB_FEEDS=main,wfh,fresher
# Development only: cache raw HTML ("1" → packages/scrapers/internshala/.cache/http, or a directory path).
# INTERNSHALA_DEV_CACHE=1

# ══ Scrapers · LinkedIn + Naukri — OFF by default (packages/scrapers/portals) ═════════════════════
# (from packages/scrapers/portals/.env.example)
# @easyjobs/scraper-portals — LinkedIn + Naukri (both OFF by default; see README.md for live status/evidence)
# ENABLE_LINKEDIN  ← see above
# ENABLE_NAUKRI  ← see above
# SCRAPER_USER_AGENT  ← see above

# LinkedIn (public guest listings) — per-run caps and query plan
# LINKEDIN_MAX_REQ_PER_RUN=10
# LINKEDIN_MAX_DETAILS_PER_RUN=6
# LINKEDIN_QUERIES_PER_RUN=2
# LINKEDIN_PAGES_PER_QUERY=1
# LINKEDIN_KEYWORDS=software engineer,developer,data analyst,data scientist,intern,fresher,graduate trainee,product manager,designer,marketing,sales,finance,HR
# f_E codes, one query each (1 internship, 2 entry, 3 associate, 4 mid-senior, 5 director, 6 executive); "any" = no filter
# LINKEDIN_EXPERIENCE=1,2
# f_WT codes applied together (1 on-site, 2 remote, 3 hybrid); empty = no filter
# LINKEDIN_WORK_TYPES=
# LINKEDIN_LOCATION=India
# LINKEDIN_TIME_POSTED=r86400

# Naukri (public search pages via headless Chromium) — a "request" is one page navigation
# NAUKRI_MAX_REQ_PER_RUN=6
# NAUKRI_MAX_DETAILS_PER_RUN=3
# NAUKRI_QUERIES_PER_RUN=2
# NAUKRI_PAGES_PER_QUERY=1
# NAUKRI_KEYWORDS=software engineer,developer,data analyst,data scientist,intern,fresher,graduate trainee,product manager,designer,marketing,sales,finance,HR
# ?experience= years, one query each (fresher-focused); "any" = no filter
# NAUKRI_EXPERIENCE=0,1
# NAUKRI_NAV_TIMEOUT_MS=45000
# NAUKRI_API_WAIT_MS=20000

# Shared politeness / backoff (the 4000 ms floor cannot be lowered)
# PORTALS_MIN_GAP_MS=4000
# PORTALS_MAX_GAP_MS=6000
# PORTALS_BACKOFF_BASE_HOURS=2
# PORTALS_BACKOFF_MAX_HOURS=168
# PORTALS_ROBOTS_RECHECK_HOURS=24
# PORTALS_STATE_DIR=packages/scrapers/portals/.state

# ══ Scrapers · open job APIs & feeds (packages/scrapers/open-apis) ════════════════════════════════
# (from packages/scrapers/open-apis/.env.example)
# @easyjobs/scraper-open-apis — all optional. Keyed sources stay disabled without their keys.

# Adzuna (free key: https://developer.adzuna.com) — enables "adzuna"
# ADZUNA_APP_ID  ← see above
# ADZUNA_APP_KEY  ← see above
# ADZUNA_MAX_PAGES=5
# ADZUNA_MAX_DAYS_OLD=3
# ADZUNA_WHAT=

# Jooble (free key: https://jooble.org/api/about) — enables "jooble"
# JOOBLE_API_KEY  ← see above
# JOOBLE_KEYWORDS=internship,fresher,graduate trainee,software engineer
# JOOBLE_LOCATION=India
# JOOBLE_MAX_PAGES=1

# Optional keys that only raise rate limits
# THEMUSE_API_KEY=
# HIMALAYAS_API_KEY=

# Paging caps
# UNSTOP_MAX_PAGES=40
# HIMALAYAS_MAX_PAGES=10
# ARBEITNOW_MAX_PAGES=3
# JOBICY_GEOS=anywhere,apac
# WWR_FEEDS=https://weworkremotely.com/remote-jobs.rss

# Hacker News "Who is hiring?"
# HN_RESOLVE_LINKS=1
# HN_RESOLVE_MAX=150
# HN_PREVIOUS_THREAD_DAYS=7

# Per-source kill switch: comma list of scraper ids, or "all"
# OPEN_APIS_DISABLED=

# Redirect cache directory ("off" disables the disk cache)
# OPEN_APIS_CACHE_DIR=

# Development only: reuse cached GET responses for N minutes (never set in production)
# OPEN_APIS_HTTP_CACHE_MIN=0
