{
  "name": "@easyjobs/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EasyJobs scheduler + ingestion worker: discovers scraper packages, runs them on a smart schedule, normalizes, dedupes and ships batches to the API.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts start",
    "dev": "tsx watch --clear-screen=false src/cli.ts start",
    "once": "tsx src/cli.ts once",
    "list": "tsx src/cli.ts list",
    "replay": "tsx src/cli.ts replay",
    "worker": "tsx src/cli.ts",
    "fake-api": "tsx src/dev/fake-ingest-cli.ts",
    "bench": "tsx src/dev/bench.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@easyjobs/contract": "workspace:*",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
