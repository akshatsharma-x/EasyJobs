# EasyJobs web (apps/web). Copy the keys you need into the repo-root .env.
# "1" (default) = in-memory mock API; "0" = real API at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCKS=1
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: server-side base URL for the API when it differs from the public one (Docker, private network).
API_INTERNAL_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: simulated network latency for the browser mock (ms).
NEXT_PUBLIC_MOCK_LATENCY_MS=120
# Optional (server-only): logo.dev token for sharper company logos via the /logo/<domain> proxy.
LOGO_DEV_TOKEN=
