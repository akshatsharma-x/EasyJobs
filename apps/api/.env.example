# @easyjobs/api — Hono on Node (the root .env is loaded automatically). DB variables: packages/db/.env.example

API_PORT=4000
# API_HOST=0.0.0.0            # listen address (default: all interfaces)
WEB_ORIGIN=http://localhost:3000   # CORS allow-list, comma-separated ("*" = any)
INGEST_API_KEY=dev-ingest-key      # required in x-ingest-key on /v1/ingest/*

# Per-IP token bucket on public /v1/* routes (0 disables). TRUST_PROXY=1 → use X-Forwarded-For.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=100
TRUST_PROXY=0

# In-memory LRU for search / facets / stats / suggest (0 disables) — responses also carry ETag + Cache-Control.
CACHE_TTL_MS=20000
CACHE_MAX_ENTRIES=2000

# Live stream (/v1/stream)
SSE_HEARTBEAT_MS=25000
SSE_STATS_MS=30000
SSE_MAX_PER_IP=20
SSE_MAX_CLIENTS=5000

# Freshness rules (validThrough, 21/45-day board-only rules) run this often.
EXPIRE_INTERVAL_MS=3600000

# Body limits for /v1/ingest/* (bytes; gzip/deflate/br request bodies are decompressed up to the inflated limit)
INGEST_MAX_BYTES=16777216
INGEST_MAX_INFLATED_BYTES=67108864
INGEST_OTHER_MAX_BYTES=16777216

LOG_LEVEL=info     # debug | info | warn | error (debug logs every request)
LOG_FORMAT=        # json for JSON lines
