{
  "name": "@easyjobs/normalize",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turns any RawJob into a clean, consistent JobInput (levels, experience, salary, locations, skills, batches, fingerprints, sanitized HTML).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "bench": "tsx scripts/bench.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@easyjobs/contract": "workspace:*",
    "entities": "^9.0.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
