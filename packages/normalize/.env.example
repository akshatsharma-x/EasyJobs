# @easyjobs/normalize: every variable is optional. Without any of them, the normalizer is fully offline.
# The library reads process.env when it is called; host apps load it themselves (the worker loads <repo>/.env).
# The CLI loads packages/normalize/.env, then <repo>/.env, if present. Variables already set in the shell win.

# companyLogoUrl: with a token, https://img.logo.dev/<domain>?token=…&size=128; without one, the Google favicon.
LOGO_DEV_TOKEN=

# Optional enrichWithLLM, for low-confidence records only. Without a key it does nothing.
ANTHROPIC_API_KEY=
# Model override (default claude-haiku-5-5).
NORMALIZE_LLM_MODEL=claude-haiku-5-5
# Disk cache keyed by fingerprint (default packages/normalize/.cache/llm, gitignored).
NORMALIZE_LLM_CACHE_DIR=
# CLI --llm: max API requests per run (default 100). Cache hits don't count.
NORMALIZE_LLM_MAX_CALLS=100

# Tests only: throughput floor that test/perf.test.ts asserts, in jobs per main-thread CPU-second.
# The default is a 500 jobs/s sanity floor; 5000 enforces the target (run it on a machine that isn't swapping).
PERF_MIN_JOBS_PER_SEC=
