{
  "name": "@easyjobs/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ats": "./src/ats.ts",
    "./data/companies.json": "./data/companies.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "candidates": "tsx scripts/candidates.ts",
    "detect": "tsx scripts/detect-ats.ts",
    "probe": "tsx scripts/probe.ts",
    "verify": "tsx scripts/verify.ts",
    "summary": "tsx scripts/summary.ts",
    "fixtures": "tsx scripts/make-fixtures.ts"
  },
  "dependencies": {
    "@easyjobs/contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
