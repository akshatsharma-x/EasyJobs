# @easyjobs/scraper-coursejoiner — CourseJoiner + FreshersHunt + FresherOffCampus + KickCharm
# Bot identity (robots.txt groups are matched against it). Defaults to the contract's DEFAULT_USER_AGENT.
SCRAPER_USER_AGENT=EasyJobsBot/1.0 (+https://easyjobs.example/bot)

# Per-site toggles (default on; set 0 to disable)
ENABLE_COURSEJOINER=1
ENABLE_FRESHERSHUNT=1
ENABLE_FRESHEROFFCAMPUS=1
ENABLE_KICKCHARM=1

# Backfill / refresh window in days (default 60). Per site: COURSEJOINER_BACKFILL_DAYS, FRESHERSHUNT_BACKFILL_DAYS, …
WPJOBS_BACKFILL_DAYS=60
# When the worker passes ctx.since, run a full-window refresh at most every N hours (default 24)
WPJOBS_REFRESH_HOURS=24
# Cache root (default: packages/scrapers/coursejoiner/.cache). "off" = in-memory only.
WPJOBS_CACHE_DIR=

# Optional LLM extraction for low-confidence posts (not needed; heuristics work without it)
ANTHROPIC_API_KEY=
WPJOBS_LLM=1
WPJOBS_LLM_MODEL=claude-haiku-5-5
WPJOBS_LLM_MAX_CALLS=30
