    "applicants": 64,
    "applyBy": "25 Dec' 26",
    "category": "Fundraising",
    "companyActivity": [
      "Hiring since April 2023",
      "2416 opportunities posted",
      "161683 candidates hired",
    ],
    "companyPageUrl": "https://internshala.com/company/she-can-foundation-1682405238",
