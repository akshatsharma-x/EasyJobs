# @easyjobs/scraper-internshala — every variable is optional (defaults shown).

# 0/false disables both Internshala scrapers.
INTERNSHALA_ENABLED=1
# Listing pages per feed per run ("all" for a one-off backfill).
INTERNSHALA_MAX_PAGES=10
# Detail pages per scraper run ("all" = no cap, 0 = cards only).
INTERNSHALA_MAX_DETAILS=100
# Rotating deeper pages of the main feed per incremental run (keeps long-lived postings "seen").
INTERNSHALA_REFRESH_PAGES=2
# Consecutive pages made entirely of known ids that end a feed.
INTERNSHALA_STOP_AFTER_KNOWN_PAGES=1
# Gap between requests in ms (minimum 1500 — Internshala's budget is ≤ 1 request / 1.5 s).
INTERNSHALA_DELAY_MS=1500
# Feeds to crawl, in order.
INTERNSHALA_INTERNSHIP_FEEDS=main,wfh,women
INTERNSHALA_JOB_FEEDS=main,wfh,fresher
# Development only: cache raw HTML ("1" → packages/scrapers/internshala/.cache/http, or a directory path).
# INTERNSHALA_DEV_CACHE=1
