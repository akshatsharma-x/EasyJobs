{
  "name": "@easyjobs/scraper-ats-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EasyJobs scrapers for public ATS job-board APIs: Greenhouse, Lever, Ashby, SmartRecruiters, Workable, Recruitee, BambooHR, Personio, Breezy, Teamtailor.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "scrape": "tsx src/cli.ts",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "fixtures": "tsx scripts/capture-fixtures.ts",
    "verify-targets": "tsx scripts/verify-targets.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@easyjobs/contract": "workspace:*",
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
