# @easyjobs/scraper-ats-public — all optional

# Comma-separated scraper ids to switch off (greenhouse, lever, ashby, smartrecruiters, workable,
# recruitee, bamboohr, personio, breezy, teamtailor), or "all".
ATS_PUBLIC_DISABLED=

# Max per-posting detail requests per target per run (SmartRecruiters, BambooHR). Unknown postings beyond the
# cap are fetched on the next run.
ATS_MAX_DETAILS=200

# Bot identity used by the contract HTTP client (put a real contact URL here in production).
SCRAPER_USER_AGENT=EasyJobsBot/1.0 (+https://easyjobs.example/bot)

# Set to 1 to run test/live.test.ts against the real APIs.
LIVE=
