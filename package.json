{
  "name": "easyjobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "scrape:once": "node scripts/scrape-once.mjs",
    "seed": "pnpm --filter @easyjobs/db seed",
    "reset": "node scripts/reset.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "node scripts/lint.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "build": "pnpm --filter @easyjobs/web build",
    "worker": "pnpm --filter @easyjobs/worker worker",
    "data-quality": "tsx scripts/data-quality.ts",
    "sample-jobs": "tsx scripts/sample-jobs.ts",
    "reclassify": "tsx scripts/reclassify.ts",
    "resilience-drill": "tsx scripts/resilience-drill.ts"
  },
  "devDependencies": {
    "@easyjobs/contract": "workspace:*",
    "@easyjobs/db": "workspace:*",
    "@easyjobs/normalize": "workspace:*",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@12.23.0"
}
